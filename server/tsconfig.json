{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "node20",
    "moduleResolution": "node16",
    "lib": ["ES2020"],
    "outDir": "../dist",
    "noEmit": false,
    "jsx": "react",
    "baseUrl": ".",
    "paths": {
      "@server/*": ["*"],
      "@app/*": ["../src/*"],
      "@tests/*": ["../tests/*"],
      "@contract/*": ["../contract/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
